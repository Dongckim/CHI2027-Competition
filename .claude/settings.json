{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": { "commit": "", "pr": "" },
  "permissions": {
    "allow": [
      "Bash(git push -u origin stage/*)",
      "Bash(git push origin stage/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge * --merge*)",
      "Bash(gh auth status*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * main*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git remote *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(gh pr merge *--squash*)",
      "Bash(gh pr merge *--rebase*)",
      "Bash(gh pr merge *--admin*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
